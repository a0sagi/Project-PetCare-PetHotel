{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Java",
            "type": "shell",
            "command": "javac",
            "args": [
                "--release",
                "17",
                "-encoding",
                "UTF-8",
                "-cp",
                "lib/*",
                "-sourcepath",
                "src",
                "-d",
                "out",
                "src/Main.java"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$javac"
            ]
        },
        {
            "label": "Run Java (GUI)",
            "type": "shell",
            "command": "java",
            "args": [
                "-cp",
                "out;lib/*",
                "Main"
            ],
            "dependsOn": "Build Java",
            "group": "none",
            "problemMatcher": []
        }
    ]
}
